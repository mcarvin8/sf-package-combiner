{
  "name": "sf-package-combiner-core",
  "description": "Dependency-free library that merges multiple Salesforce package.xml manifests into a single file",
  "version": "4.3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepack": "npm run --prefix ../.. build:core"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Matt Carvin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcarvin8/sf-package-combiner.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mcarvin8/sf-package-combiner/issues"
  },
  "homepage": "https://github.com/mcarvin8/sf-package-combiner#programmatic-api",
  "keywords": [
    "salesforce",
    "salesforcedx",
    "package.xml",
    "manifest",
    "combiner",
    "combine",
    "merge",
    "xml",
    "deployment"
  ]
}
